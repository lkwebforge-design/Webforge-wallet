# Configure these only in the backend host's secret manager.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/phonelanka_finance
DATABASE_SSL=true
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD_HASH=REPLACE_WITH_ARGON2ID_HASH
APP_ORIGIN=https://YOUR-APP-DOMAIN.example
TRUST_PROXY=true
PORT=8787
